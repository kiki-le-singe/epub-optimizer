{
  "name": "epub-optimizer",
  "version": "3.12.0",
  "description": "Optimize EPUB files by compressing HTML, CSS, images and recompressing the archive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiki-le-singe/epub-optimizer.git"
  },
  "homepage": "https://github.com/kiki-le-singe/epub-optimizer#readme",
  "bugs": {
    "url": "https://github.com/kiki-le-singe/epub-optimizer/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "bin": {
    "epub-optimizer": "dist/src/pipeline.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/install-epubcheck.sh"
  ],
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "scripts": {
    "# Build commands": "# Complete pipeline processes",
    "build": "pnpm run build:prod",
    "build:dev": "tsc",
    "build:prod": "node --experimental-strip-types scripts/clean-path.ts dist && tsc -p tsconfig.prod.json",
    "minify:safe": "node --experimental-strip-types scripts/minify-dist.ts",
    "prepack": "pnpm run build",
    "optimize": "node dist/src/pipeline.js",
    "optimize:author": "node dist/src/pipeline.js --preset author",
    "optimize:repair": "node dist/src/pipeline.js --repair",
    "optimize:lossless": "node dist/src/pipeline.js --preset lossless",
    "optimize:clean": "node dist/src/pipeline.js --clean",
    "cleanup": "node --experimental-strip-types scripts/cleanup-temp.ts",
    "# Dev tools": "# Development utilities",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --experimental-strip-types scripts/e2e-epubcheck.ts",
    "test:package": "node --experimental-strip-types scripts/package-e2e.ts",
    "test:docker": "node --experimental-strip-types scripts/docker-e2e.ts",
    "release:check": "node --experimental-strip-types scripts/validate-release.ts",
    "release:prepare": "node --experimental-strip-types scripts/prepare-release.ts",
    "lint": "eslint src scripts --ext .ts",
    "lint:fix": "eslint src scripts --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "author": "kiki-le-singe",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "clean-css": "^5.3.3",
    "entities": "^7.0.1",
    "fontverter": "2.0.0",
    "fs-extra": "^11.4.1",
    "html-minifier-terser": "^7.2.0",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5",
    "subset-font": "2.9.0",
    "svgo": "^4.1.0",
    "terser": "^5.51.2",
    "unzipper": "^0.12.5",
    "yargs": "^18.2.0",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.5": "5.0.6",
      "cheerio>undici": "^7.30.1",
      "vite": "^8.3.7"
    }
  },
  "keywords": [
    "epub",
    "optimizer",
    "compression",
    "minification",
    "ebook"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/clean-css": "^4.2.11",
    "@types/fs-extra": "^11.0.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^22.20.5",
    "@types/unzipper": "^0.10.11",
    "@types/yargs": "^17.0.35",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "harfbuzzjs": "1.6.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
